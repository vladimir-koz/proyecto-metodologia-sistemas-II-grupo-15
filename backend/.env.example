NODE_ENV=development
PORT=3001

# API ejecutada fuera de Docker y PostgreSQL publicado por Docker Compose
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_database
DB_USER=app_user
DB_PASSWORD=app_password
DB_SSL=false

# Dentro de Docker Compose, el servicio backend recibe estos valores del compose:
# DB_HOST=database
# DB_PORT=5432

# Alternativa para un proveedor externo de PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@host:5432/base
# DB_SSL=true

# Obligatoria. Usar un valor largo y diferente en cada entorno.
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# Origen autorizado para un cliente web futuro.
CORS_ORIGIN=http://localhost:5173
